# Environment
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Database
DATABASE_URL=postgresql://esapiens:local_only_change_me@localhost:5433/esapiens
# Maximum per API/worker process; replicas multiply this value.
DATABASE_POOL_MAX=10

# Public institutional payment instructions. No passwords, secrets or card data.
# Leave empty to disable new purchases. Replace with verified bank/QR instructions.
PAYMENT_INSTRUCTIONS=

# Redis
REDIS_URL=redis://localhost:6379

# Auth: opaque revocable sessions. No JWT/session signing secret is required.
# APP_URL must exactly match the browser origin (HTTPS in production).
# Optional trusted Swagger origin, local development only. Ignored in production.
# Must match the address opened in the browser, without a path or trailing slash.
SWAGGER_ORIGIN=http://localhost:4000

# Internal HTTP services (pnpm dev/setup:demo generates the local token if empty)
CONTENT_SERVICE_URL=http://127.0.0.1:4001
ANALYTICS_SERVICE_URL=http://127.0.0.1:4002
IDENTITY_SERVICE_URL=http://127.0.0.1:4003
ACADEMIC_SERVICE_URL=http://127.0.0.1:4004
CONTENT_SERVICE_PORT=4001
ANALYTICS_SERVICE_PORT=4002
IDENTITY_SERVICE_PORT=4003
ACADEMIC_SERVICE_PORT=4004
INTERNAL_SERVICE_TOKEN=
SERVICE_BIND_HOST=127.0.0.1
