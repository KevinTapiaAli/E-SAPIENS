# Environment
NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://esapiens:change_me@localhost:5432/esapiens

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SESSION_SECRET=replace_in_real_env
ACCESS_TOKEN_SECRET=replace_in_real_env
REFRESH_TOKEN_SECRET=replace_in_real_env

# Storage
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=replace_me
AWS_CLOUDFRONT_DOMAIN=replace_me

# Email
EMAIL_PROVIDER=ses
EMAIL_FROM=no-reply@example.com

# WhatsApp
WHATSAPP_PROVIDER=disabled

# Payments
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace_in_real_env

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
