{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "apps/web/.env.local"],
  "tasks": {
    "build": {
      "env": ["API_URL", "APP_URL"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "PAYMENT_INSTRUCTIONS",
        "REDIS_URL",
        "API_URL",
        "APP_URL",
        "SWAGGER_ORIGIN",
        "PORT",
        "API_PORT",
        "APP_ENV",
        "NODE_ENV",
        "CONTENT_SERVICE_URL",
        "ANALYTICS_SERVICE_URL",
        "IDENTITY_SERVICE_URL",
        "ACADEMIC_SERVICE_URL",
        "CONTENT_SERVICE_PORT",
        "ANALYTICS_SERVICE_PORT",
        "IDENTITY_SERVICE_PORT",
        "ACADEMIC_SERVICE_PORT",
        "INTERNAL_SERVICE_TOKEN",
        "SERVICE_BIND_HOST"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "API_URL",
        "APP_URL",
        "APP_ENV",
        "NODE_ENV"
      ]
    }
  }
}
