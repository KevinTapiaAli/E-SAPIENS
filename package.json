{
  "name": "esapiens-lms",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "dev": "turbo dev",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format:check": "prettier --check .",
    "db:check": "node scripts/database.mjs check",
    "db:migrate": "node scripts/migrate.mjs",
    "analytics:prune": "node scripts/prune-analytics.mjs",
    "account:create": "pnpm --dir apps/api exec ts-node src/cli/create-account.ts",
    "db:init": "node scripts/database.mjs init",
    "db:prepare": "node scripts/database.mjs prepare",
    "db:seed:demo": "node scripts/database.mjs seed-demo",
    "db:seed:classroom": "node scripts/database.mjs seed-classroom"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.13",
    "typescript": "7.0.2"
  }
}
